# Copy this file to .env and replace every placeholder with private values.
NODE_ENV=development
PORT=3000

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-private-supabase-service-role-key

# Generate separate random values of at least 32 bytes for each secret.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-bytes
ENCRYPTION_KEY=replace-with-a-different-private-random-secret-at-least-32-bytes
CSRF_SECRET=replace-with-another-private-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=15m

# Google OAuth: use the same Web client ID in the frontend and backend.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional email delivery settings for OTP and password-reset messages.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-account@example.com
SMTP_PASS=replace-with-private-smtp-password
EMAIL_FROM=your-smtp-account@example.com

# Optional local development settings.
DEBUG_OTP=false
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_STAFF_PASSWORD=replace-with-a-different-unique-password-at-least-12-characters
BACKUP_DIR=
